# Copy this file to ".env" and replace placeholder values with real secrets.
# NEVER commit the real .env file.

# ── Core (required) ────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
QDRANT_API_KEY=your_qdrant_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Voice layer (required for /chat/voice and /chat/speak) ─────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Zoe's dedicated ElevenLabs voice ID (create a custom voice in ElevenLabs dashboard)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Geolocation (optional) ─────────────────────────────────────────────────
IPINFO_TOKEN=your_ipinfo_token_here
# USER_PUBLIC_IP=1.2.3.4       # Override for local testing

# ── CORS / server (optional) ───────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000
# ALLOW_ALL_ORIGINS=true
# API_PORT=8000
