# Copy to backend/.env and fill in.

# Chat models (https://console.groq.com)
GROQ_API_KEY=
# Embeddings (https://build.nvidia.com)
NVIDIA_API_KEY=

# Vector store. docker compose starts a local Qdrant at this address.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=zenith-knowledge

# Optional overrides
# ZENITH_CHAT_MODEL=openai/gpt-oss-120b
# ZENITH_FAST_MODEL=openai/gpt-oss-20b
# ZENITH_CORS_ORIGINS=http://localhost:3000
# Keep a short profile of what the user shares, for this session only (off by default)
# ZENITH_STORE_PROFILES=false
